# Copy to .env and fill in.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Free Hugging Face access token (https://huggingface.co/settings/tokens).
# Read-only "Inference" scope is enough.
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Leave as "change-me" for local dev (auth is skipped). Set a real value
# before deploying anywhere reachable, and send it as the X-API-Key header.
API_KEY=change-me

# Postgres/pgvector, started via `docker-compose up -d`. Used for RAG
# (knowledge_chunks table, populated by `python -m app.rag.ingest`) and
# Memory (traveller_preferences, saved_places — schema auto-created).
DATABASE_URL=postgresql://sakhi:sakhi@127.0.0.1:5432/sakhi

# Browser origins allowed to call this API (comma-separated). The Vite
# frontend dev server runs on 5173 by default.
CORS_ORIGINS=http://localhost:5173
